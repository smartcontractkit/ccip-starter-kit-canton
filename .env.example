# Copy to .env and fill in your values.
# cp .env.example .env

# --- EVM (Sepolia) ---
EVM_PRIVATE_KEY=0xabc123...
ETHEREUM_SEPOLIA_RPC_URL=https://eth-sepolia.example.com

# --- Canton Ledger ---
CANTON_LEDGER_URL=https://participant.example.com/json-api
CANTON_CONFIG_PATH=./config/canton-config.json

# OIDC client credentials — scripts fetch a bearer token automatically.
# Omit CANTON_CLIENT_SECRET for interactive browser login flows.
CANTON_AUTH_URL=https://auth.example.com
CANTON_CLIENT_ID=my-client-id
CANTON_CLIENT_SECRET=

# Optional: use a pre-fetched bearer token instead of client credentials.
# CANTON_JWT=

# Optional: enable CCIP SDK debug logs (RPC fetch traffic, approve/ccipSend steps).
# CCIP_DEBUG=1
