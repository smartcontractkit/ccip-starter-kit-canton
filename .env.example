# Copy to .env and fill in your values.
# cp .env.example .env

# --- EVM (Sepolia) ---
EVM_PRIVATE_KEY=0xabc123...
ETHEREUM_SEPOLIA_RPC_URL=https://eth-sepolia.example.com

# --- Canton Ledger ---
CANTON_LEDGER_URL=https://participant.example.com/json-api
CANTON_CONFIG_PATH=./config/canton-config.json

# --- Canton OIDC authentication ---
# The auth scheme + authUrl live in the "auth" block of canton-config.json;
# credentials come from here. Without an auth block, the scheme is picked
# from which variables are set:
#   1. CANTON_JWT                          → static (pre-fetched token)
#   2. CANTON_AUTH_URL + CANTON_CLIENT_ID + CANTON_CLIENT_SECRET
#                                         → clientCredentials (machine-to-machine)
#   3. CANTON_AUTH_URL + CANTON_CLIENT_ID → authorizationCode (interactive browser login)
CANTON_CLIENT_ID=my-client-id
# Set for the client-credentials flow; omit for the browser-based authorization-code flow:
# CANTON_CLIENT_SECRET=

# Optional: use a pre-fetched bearer token instead of an OIDC flow.
# CANTON_JWT=

# Optional: enable CCIP SDK debug logs (RPC fetch traffic, approve/ccipSend steps).
# CCIP_DEBUG=1
